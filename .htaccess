<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Base URL redirects
    RewriteBase /

    # Allow access to static files (CSS, JS, images, fonts)
    RewriteCond %{REQUEST_URI} !\.(css|js|images|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$ [NC]


    # Allow direct access to verify_token.php
RewriteCond %{REQUEST_URI} ^/verify_token\.php$
RewriteRule ^ - [L]


# Remove trailing slashes (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 1. Handle root URL with parameters
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^(index\.php)?$ /index.php [L,QSA]

# 2. Handle standard pages (aboutus, contact, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L,QSA]

# 3. Handle subdirectory index files (shopify/, admin/, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1/index.php [L,QSA]

# 4. Handle subdirectory pages (shopify/callback, admin/users, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2.php -f
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ $1/$2.php [L,QSA]

# Final 404 for unmatched requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]



    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/client$
    RewriteRule ^ client.php [QSA,L]

    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/dashboard$
    RewriteRule ^ dashboard.php [QSA,L]

    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/subscribe$
    RewriteRule ^ subscribe.php [QSA,L]


    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/settings$
    RewriteRule ^ settings.php [QSA,L]

    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/shopifyclient/index$
    RewriteRule ^ /shopifyclient/index.php [QSA,L]

    # Handle client route (Embedded app)
    RewriteCond %{REQUEST_URI} ^/shopifyclient/generatepdf$
    RewriteRule ^ /shopifyclient/generatepdf.php [QSA,L]


    # Handle install flow
    RewriteCond %{REQUEST_URI} ^/shopify/install
    RewriteRule ^shopify/install$ shopify/install.php [QSA,L]

    # Handle OAuth callback
    RewriteCond %{REQUEST_URI} ^/shopify/callback
    RewriteRule ^shopify/callback$ shopify/callback.php [QSA,L]

    # Handle webhooks
    RewriteCond %{REQUEST_URI} ^/shopify/webhook
    RewriteRule ^shopify/webhook$ shopify/webhook.php [QSA,L]

    # Security: Block direct access to PHP files
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.php\ HTTP/
    RewriteRule ^(.*)\.php$ /$1 [R=301,L]

    # Security: Prevent directory listing
    Options -Indexes

    # Security: Protect sensitive files
    <FilesMatch "(\.htaccess|config\.php|db\.php)">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(css|js|images|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>

# Required for embedded apps
#<IfModule mod_headers.c>
#    Header always set Content-Security-Policy "frame-ancestors https://*.shopify.com https://admin.shopify.com;"
#    Header always set X-Frame-Options "ALLOW-FROM https://admin.shopify.com"
#</IfModule>
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "frame-ancestors https://*.shopify.com https://admin.shopify.com;"
    Header always unset X-Frame-Options
</IfModule>
